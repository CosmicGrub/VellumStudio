# Template for tablet-app/keystore.properties -- the real file is gitignored and must never be
# committed. Copy this file to tablet-app/keystore.properties and fill in the real values:
#
#   cp keystore.properties.example keystore.properties
#
# `gradlew :app:assembleRelease` (and bundleRelease/packageRelease/installRelease) FAILS CLOSED
# without a valid keystore.properties: a debug-signed "release" APK cannot be installed over the
# real-signed one (Android rejects the signature mismatch), so it is refused rather than produced
# silently. The only opt-out is an explicit `-PallowDebugSignedRelease=true` (for verification
# builds that are never distributed). See docs/RELEASING.md.
#
# The keystore file itself should live OUTSIDE every git worktree, so a worktree-wide operation or
# a stray `git add -f` can never stage it. Use an absolute storeFile path (forward slashes on
# Windows); a relative one resolves against tablet-app/app/, not this folder.
storeFile=/path/to/keystore/vellum-studio-release.jks
storePassword=CHANGE_ME
keyAlias=vellum-studio
keyPassword=CHANGE_ME
