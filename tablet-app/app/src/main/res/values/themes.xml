<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.VellumStudio" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/ink_bg</item>
        <item name="android:statusBarColor">@color/ink_bg</item>
        <item name="android:navigationBarColor">@color/ink_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.VellumStudio.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.VellumStudio</item>
    </style>

</resources>
