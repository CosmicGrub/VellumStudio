<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.NSD" android:minSdkVersion="35" />

    <uses-feature
        android:name="android.hardware.faketouch"
        android:required="false" />

    <application
        android:name=".VellumApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VellumStudio"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:banner="@mipmap/ic_launcher">

        <!-- Required by Macrobenchmark (see the ":benchmark" module) so it can read detailed
             trace data (frame timing, ART compilation state) from a non-debuggable "benchmark" or
             "release" build via `adb shell`, without making the app debuggable. android:shell="true"
             scopes this to the shell UID (i.e. adb/UiAutomator) only; it does not expose profiling
             to arbitrary other apps on the device. Needs no tools:targetApi override since minSdk
             is already 29, the same level this element itself requires. -->
        <profileable android:shell="true" />

        <!-- configChanges: every configuration change this Activity is expected to see mid-session
             is handled in place instead of recreating it. A recreate reloads the editor from disk
             and silently drops any strokes/undo history that hadn't been saved yet, so the list
             must cover what a real tablet session actually triggers: attaching/detaching the Book
             Cover Keyboard (keyboard, navigation -- keyboardHidden alone does NOT cover this; the
             app registers keyboard shortcuts specifically for that accessory), changing the system
             font size (fontScale), switching the system language (locale, layoutDirection), and
             fold/resize/rotation/dark-mode changes. Compose re-reads LocalConfiguration on each of
             these, so no manual handling is needed. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize|density|uiMode|fontScale|locale|layoutDirection"
            android:theme="@style/Theme.VellumStudio.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Grants the share sheet temporary read access to the diagnostic log (Settings >
             Diagnostics > Export) via a content:// Uri, since app-private files/ isn't otherwise
             reachable outside this app and a plain file:// Uri would violate FileUriExposedException
             on API 24+. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    </application>

</manifest>
