<Window x:Class="VellumCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Vellum Studio — PC Companion"
        Height="520" Width="760"
        MinHeight="420" MinWidth="600">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection bar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Tablet address (IP:port):"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />

            <TextBox x:Name="TabletAddressTextBox"
                     Grid.Column="1"
                     Text="192.168.1.23:8642"
                     VerticalAlignment="Center"
                     Padding="4"
                     ToolTip="LAN IP and port of the tablet's sync server. Default port is 8642." />

            <Button x:Name="ConnectButton"
                    Grid.Column="2"
                    Content="Connect"
                    Margin="8,0,0,0"
                    Padding="14,4"
                    Click="ConnectButton_Click" />
        </Grid>

        <!-- Main content -->
        <TabControl Grid.Row="1">

            <TabItem Header="Projects">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListView x:Name="ProjectsListView"
                              Grid.Row="0"
                              SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="380"
                                                DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Last Updated" Width="220"
                                                DisplayMemberBinding="{Binding UpdatedAt}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Button x:Name="DownloadButton"
                            Grid.Row="1"
                            Content="Download Project…"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Padding="14,6"
                            IsEnabled="False"
                            Click="DownloadButton_Click" />
                </Grid>
            </TabItem>

            <TabItem Header="Live Mirror">
                <!--
                    Placeholder UI shell for a future real-time canvas mirror.

                    Intended protocol (NOT implemented yet):
                      - PC opens a WebSocket connection to ws://{tablet}:8642/mirror
                      - While the mirror session is active, the tablet app
                        encodes its canvas to a downscaled JPEG on every
                        committed stroke (or on a throttled timer, e.g. 10-15fps)
                        and pushes each frame as a binary WebSocket message.
                      - The PC receives each binary frame, decodes it (e.g. via
                        JpegBitmapDecoder), and updates the Source of the
                        MirrorImage control below with the resulting
                        BitmapImage/BitmapFrame.
                      - This is strictly view-only: no input, pen strokes, or
                        control signals are sent back to the tablet over this
                        channel. It requires no virtual display or HID driver
                        on the PC — see the README's "Future" section for why
                        a true tablet-as-display mode is a much bigger lift.
                -->
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#FF1E1E1E"
                            CornerRadius="4">
                        <Grid>
                            <!-- Future: bind Source to frames received over the /mirror WebSocket. -->
                            <Image x:Name="MirrorImage"
                                   Stretch="Uniform" />

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Live Mirror — Coming soon"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Real-time, view-only canvas mirroring over WebSocket."
                                           Foreground="#FFBBBBBB"
                                           FontSize="12"
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button x:Name="StartMirrorButton"
                            Grid.Row="1"
                            Content="Start Live Mirror (Coming soon)"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Padding="14,6"
                            IsEnabled="False" />
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Status bar -->
        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="2"
                   Margin="0,10,0,0"
                   Text="Not connected."
                   Foreground="Gray"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
